{
    //===================================================================
    // Room — オーバーレイ共有(ニコニコ風の流れるコメント)
    //===================================================================
    // 発話・文字入力は画面全体のオーバーレイに流れる。ルームに参加すると
    // 中継サーバ経由でメンバーの画面にも流れる(本文は E2E 暗号化)。
    "room": {
        // 中継サーバ(server/ を Cloudflare Workers にデプロイした URL)。
        // 空でもオーバーレイは動く(ルーム未参加=自分の画面にだけ流れるソロモード)。
        // 本文は E2E 暗号化され、サーバには暗号文しか渡らない。
        "server": "",
        // 文字入力バーを出すキー(音声トリガの hotkey とは別のキーにする)。
        // 単体修飾キー(rightcmd 等)のほか、修飾キー 2 つのコードも指定できる
        // (mods に押しっぱなしにする側を 1 つ書く)。JIS 配列には右⌥ が無い。
        "input_hotkey": {
            "mods": [],
            "key": "rightcmd"
        },
        // 記名ルーム(メニューの「新規ルームを作成 — 記名」で作る)で名乗る表示名。
        // 空なら記名ルームの作成/参加時に入力を促す(入力は内部ファイルに保存され次回以降は
        // 聞かない)。ここに設定した場合はそれが最優先。匿名ルームでは無視される。
        "display_name": ""
    },

    //===================================================================
    // Input — 録音・入力(どう録るか)
    //===================================================================
    // 音声入力(マイク→文字起こし)を使うか。false なら文字入力バー(room.input_hotkey)
    // だけになり、マイク・whisper・Ollama を一切使わない。スピーカーで会議音声を流して
    // いて他人の声を拾いたくない場合などに false にする。
    "voice_input": true,
    // "vad" = 無音で自動区切り(ホットキーでトグル)/ "ptt" = 押している間だけ録音
    "listen_mode": "vad",
    "vad": {
        // 音声検出のしきい値(URATALK_DEBUG=1 で rms= を見て調整)
        "threshold": 0.01,
        // これより短い音は発話と見なさない
        "min_speech_ms": 300,
        // この長さの無音で 1 発話を区切る
        "silence_ms": 700,
        // 1 発話の最大長(これを超えたら強制区切り)
        "max_segment_ms": 15000,
        // 発話頭の取りこぼし防止に遡って含める長さ
        "preroll_ms": 300
    },
    // 音声リッスンの開始/停止(vad)・録音(ptt)のホットキー。単体修飾キーか
    // mods+key、修飾キー 2 つのコードも可。指定できるキーは  ura-talk keys  。
    // input_hotkey(文字入力バー)とは別のキーにすること。
    "hotkey": {
        "mods": ["rightshift"],
        "key": "rightcmd"
    },
    // 録音に使うマイク。デバイス名の部分一致(空ならシステム既定デバイス)。候補は  ura-talk devices  。
    // 指定した名前がどのデバイスにも一致しないと起動に失敗するので注意。
    // Bluetooth イヤホン使用時は内蔵マイク(例 "MacBook")を明示すると、録音開始で
    // イヤホンが通話モードに切り替わり再生音が劣化するのを防げる。
    "input_device": "",
    // 自動ゲイン: 小声を持ち上げてから文字起こしへ渡す(認識精度の底上げ)
    "gain": {
        "enabled": true,
        "target_peak": 0.95,
        "max_gain": 12
    },
    // これより短い録音は捨てる(ptt の押し間違い対策)
    "min_duration_ms": 300,
    // 開始/停止の効果音(/System/Library/Sounds の名前・拡張子なし)
    "sound": {
        "enabled": true,
        "on": "Submarine",
        "off": "Bottle"
    },

    //===================================================================
    // Transcription — 文字起こし(whisper.cpp)
    //===================================================================
    // whisper-cli の場所(brew install whisper-cpp)
    "whisper_bin": "/opt/homebrew/bin/whisper-cli",
    // ggml モデルのパス(make setup / make model で取得・設定できる)
    "whisper_model": "~/.config/ura-talk/models/ggml-large-v3-turbo.bin",
    // 文字起こし言語("ja" / 自動判定なら "auto" など)
    "language": "ja",
    // 語彙・口調のヒント(誤認識の低減)
    "whisper_prompt": "会議での相槌やコメント。なるほど、確かに、それいいですね、賛成です。",
    // ビーム幅(0 で既定 5。上げると精度↑・速度↓)
    "whisper_beam_size": 5,
    // 無音判定のしきい値(上げると幻聴=無音からの空発話が減る)
    "whisper_no_speech_thold": 0.6,

    //===================================================================
    // Refine — 整形(Local LLM / Ollama)
    //===================================================================
    // enabled: true で文字起こし結果を読みやすく整形(失敗時は素のテキスト)
    "enhance": {
        "enabled": true,
        "backend": "ollama",
        "endpoint": "http://localhost:11434",
        "model": "qwen2.5:3b",
        "prompt": "",
        // allow_remote: endpoint に localhost 以外のホストを許すか(既定 false)。
        // ⚠️ endpoint には発話本文がそのまま送られる。false のままなら localhost/
        //    127.0.0.1/::1 以外の endpoint は拒否され、発話が外部へ出ることはない。
        //    意図的にリモート Ollama を使う場合のみ true にする(発話が外部に出る点に注意)。
        "allow_remote": false
    },
    // 発話内容に応じて末尾に絵文字を付ける(本文は変えない)。上の Ollama を使う。
    // mode: off(付けない=ビジネスライク)/ light(控えめ)/ cheerful(積極的に明るく)
    "emoji": {
        "mode": "off"
    }
}
