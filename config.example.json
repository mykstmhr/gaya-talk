{
    //===================================================================
    // Room — オーバーレイ共有(ニコニコ風の流れるコメント)
    //===================================================================
    // 発話・文字入力は画面全体のオーバーレイに流れる。ルームに参加すると
    // 中継サーバ経由でメンバーの画面にも流れる(本文は E2E 暗号化)。
    "room": {
        // 中継サーバ(server/ を Cloudflare Workers にデプロイした URL)。
        // 空でもオーバーレイは動く(ルーム未参加=自分の画面にだけ流れるソロモード)。
        // 本文は E2E 暗号化され、サーバには暗号文しか渡らない。
        "server": "",
        // ルーム作成の認証シークレット(サーバ側で `wrangler secret put CREATE_SECRET` を
        // 設定している場合のみ必要。参加だけの人は不要)。環境変数
        // URATALK_ROOM_CREATE_SECRET でも渡せる(config に平文で書きたくない場合)。
        "create_secret": "",
        // 記名ルーム(メニューの「新規ルームを作成 — 記名」で作る)で名乗る表示名。
        // 空なら記名ルームの作成/参加時に入力を促す(入力は内部ファイルに保存され次回以降は
        // 聞かない)。ここに設定した場合はそれが最優先。匿名ルームでは無視される。
        "display_name": "",
        // Slack ミラー(任意): ルームのコメントを Slack チャンネルへスレッドで転送する。
        // 設定した人だけが「ミラー役」になれる(他のメンバーは設定不要)。両方空ならメニューに
        // 「Slack に記録」は出ない。bot token は環境変数 URATALK_SLACK_BOT_TOKEN でも渡せる。
        // 必要な準備: Slack アプリを作成 → Bot Token Scopes に chat:write → ワークスペースに
        // インストール(xoxb-... を取得)→ 投稿先チャンネルに bot を招待。
        "slack_bot_token": "",
        "slack_channel": ""
    },

    //===================================================================
    // 文字入力バー — 主入力(ルーム未参加のソロモードでも使える)
    //===================================================================
    // 文字入力バーを出すキー(音声トリガの voice.hotkey とは別のキーにする)。
    // 単体修飾キー(rightcmd 等)のほか、修飾キー 2 つのコードも指定できる
    // (mods に押しっぱなしにする側を 1 つ書く)。JIS 配列には右⌥ が無い。
    // 指定できるキーは  ura-talk keys  。
    "input_hotkey": {
        "mods": [],
        "key": "rightcmd"
    },

    // 効果音(/System/Library/Sounds の名前・拡張子なし)。全部止めるなら enabled: false、
    // 個別に止めるなら名前を "" にする。
    "sound": {
        "enabled": true,
        // 文字入力バーを開いたとき・閉じたとき
        "input_open": "Pop",
        "input_close": "Bottle",
        // 音声リッスン/録音の開始・停止
        "on": "Submarine",
        "off": "Bottle"
    },

    //===================================================================
    // Voice — 音声入力(使わない人は "input": "off" だけで OK)
    //===================================================================
    "voice": {
        // 音声入力(マイク→文字起こし)の可否: "auto" / "on" / "off"。
        //   auto(既定) = 出力がイヤホンならオン、スピーカーなら自動オフ(相手の声を拾わない)
        //   on         = 常に有効
        //   off        = 文字入力バー(input_hotkey)だけ。マイク・whisper・Ollama を一切使わない
        //                (文字だけで参加する人向け。whisper.cpp もモデルも不要)
        "input": "auto",
        // 音声リッスンの開始/停止(vad)・録音(ptt)のホットキー。形式は input_hotkey と
        // 同じ(別のキーにすること)。
        "hotkey": {
            "mods": ["rightshift"],
            "key": "rightcmd"
        },
        // "vad" = 無音で自動区切り(ホットキーでトグル)/ "ptt" = 押している間だけ録音
        "listen_mode": "vad",
        // 録音に使うマイク。デバイス名の部分一致(空ならシステム既定デバイス)。候補は  ura-talk devices  。
        // 指定した名前がどのデバイスにも一致しないと起動に失敗するので注意。
        // Bluetooth イヤホン使用時は内蔵マイク(例 "MacBook")を明示すると、録音開始で
        // イヤホンが通話モードに切り替わり再生音が劣化するのを防げる。
        "device": "",
        "vad": {
            // 音声検出のしきい値(URATALK_DEBUG=1 で rms= を見て調整)
            "threshold": 0.01,
            // これより短い音は発話と見なさない
            "min_speech_ms": 300,
            // この長さの無音で 1 発話を区切る
            "silence_ms": 700,
            // 1 発話の最大長(これを超えたら強制区切り)
            "max_segment_ms": 15000,
            // 発話頭の取りこぼし防止に遡って含める長さ
            "preroll_ms": 300
        },
        // 自動ゲイン: 小声を持ち上げてから文字起こしへ渡す(認識精度の底上げ)
        "gain": {
            "enabled": true,
            "target_peak": 0.95,
            "max_gain": 12
        },
        // これより短い録音は捨てる(ptt の押し間違い対策)
        "min_duration_ms": 300,
        // リッスン/録音中に画面下部へ小さな状態バー(音量メーター付き)を出す。
        // バーは画面共有には映らず、クリックは下のアプリへ素通しする。
        "bar": true
    },

    //===================================================================
    // Whisper — 文字起こし(whisper.cpp。voice.input:"off" なら不要)
    //===================================================================
    "whisper": {
        // whisper-cli の場所(brew install whisper-cpp)
        "bin": "/opt/homebrew/bin/whisper-cli",
        // ggml モデルのパス(make setup-voice / make whisper-model で取得・設定できる)
        "model": "~/.config/ura-talk/models/ggml-large-v3-turbo.bin",
        // 文字起こし言語("ja" / 自動判定なら "auto" など)
        "language": "ja",
        // 語彙・口調のヒント(誤認識の低減)
        "prompt": "会議での相槌やコメント。なるほど、確かに、それいいですね、賛成です。",
        // ビーム幅(0 で既定 5。上げると精度↑・速度↓)
        "beam_size": 5,
        // 無音判定のしきい値(上げると幻聴=無音からの空発話が減る)
        "no_speech_thold": 0.6
    },

    //===================================================================
    // Refine — 整形(Local LLM / Ollama)
    //===================================================================
    // enabled: true で文字起こし結果を読みやすく整形(失敗時は素のテキスト)
    "enhance": {
        "enabled": true,
        // ura-talk 専用ポートの Ollama を自動起動して使う(アプリ終了時に一緒に停止)。
        // 他のアプリと共有している標準の Ollama を使うなら "http://localhost:11434" に
        // する(その場合はアプリ終了時も止めない)。
        "endpoint": "http://127.0.0.1:11477",
        "model": "qwen2.5:3b",
        "prompt": "",
        // allow_remote: endpoint に localhost 以外のホストを許すか(既定 false)。
        // ⚠️ endpoint には発話本文がそのまま送られる。false のままなら localhost/
        //    127.0.0.1/::1 以外の endpoint は拒否され、発話が外部へ出ることはない。
        //    意図的にリモート Ollama を使う場合のみ true にする(発話が外部に出る点に注意)。
        "allow_remote": false
    },
    // 発話内容に応じて末尾に絵文字を付ける(本文は変えない)。上の Ollama を使う。
    // mode: off(付けない=ビジネスライク)/ light(控えめ)/ cheerful(積極的に明るく)
    "emoji": {
        "mode": "off"
    }
}
